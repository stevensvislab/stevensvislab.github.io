---
/** Small inline SVG marks for social and link icons (16×16 grid, currentColor). */
interface Props {
  name: "github" | "youtube" | "linkedin" | "bluesky" | "x" | "scholar" | "email" | "site" | "external" | "copy";
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="brand-icon">
  {
    name === "github" && (
      <path
        fill="currentColor"
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
      />
    )
  }
  {
    name === "bluesky" && (
      <path
        fill="currentColor"
        d="M3.468 1.948C5.303 3.325 7.276 6.118 8 7.616c.725-1.498 2.697-4.29 4.532-5.668C13.855.955 16 .186 16 2.632c0 .489-.28 4.105-.444 4.692-.572 2.04-2.653 2.561-4.504 2.246 3.236.551 4.06 2.375 2.281 4.2-3.376 3.464-4.852-.87-5.23-1.98-.07-.204-.103-.3-.103-.218 0-.081-.033.014-.102.218-.379 1.11-1.855 5.444-5.231 1.98-1.778-1.825-.955-3.65 2.28-4.2-1.85.315-3.932-.205-4.503-2.246C.28 6.737 0 3.12 0 2.632 0 .186 2.145.955 3.468 1.948Z"
      />
    )
  }
  {
    name === "youtube" && (
      <>
        <rect x="0" y="2.5" width="16" height="11" rx="3" fill="currentColor" />
        <path d="M6.4 5.4v5.2L10.8 8z" fill="var(--paper, #fff)" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="0" y="0" width="16" height="16" rx="2.5" fill="currentColor" />
        <g fill="var(--paper, #fff)">
          <circle cx="4.3" cy="4.4" r="1.25" />
          <rect x="3.2" y="6.3" width="2.2" height="6.4" />
          <path d="M7 6.3h2.1v.9c.4-.7 1.2-1.1 2.1-1.1 1.6 0 2.5 1 2.5 2.9v3.7h-2.2V9.4c0-.9-.3-1.4-1.1-1.4s-1.2.6-1.2 1.4v3.3H7z" />
        </g>
      </>
    )
  }
  {
    name === "x" && (
      <path fill="currentColor" d="M12.2 1h2.3L9.5 6.8 15.4 15h-4.6l-3.6-4.8L3 15H.8l5.4-6.2L.5 1h4.7l3.3 4.4L12.2 1zm-.8 12.6h1.3L4.6 2.3H3.2l8.2 11.3z" />
    )
  }
  {
    name === "scholar" && (
      <path fill="currentColor" d="M8 1 0 6.2l2.9 1.9C3.6 6.3 5.6 5 8 5s4.4 1.3 5.1 3.1L16 6.2 8 1zm0 5.3a3.85 3.85 0 1 0 0 7.7 3.85 3.85 0 0 0 0-7.7z" />
    )
  }
  {
    name === "email" && (
      <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" d="M1.5 3.5h13v9h-13zM1.5 4l6.5 5 6.5-5" />
    )
  }
  {
    name === "site" && (
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.5" />
        <path d="M1.5 8h13M8 1.5c2 2 2.6 4 2.6 6.5S10 12.5 8 14.5C6 12.5 5.4 10.5 5.4 8S6 3.5 8 1.5z" />
      </g>
    )
  }
  {
    name === "external" && (
      <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M6 3H3v10h10v-3M9 2h5v5M14 2 7.5 8.5" />
    )
  }
  {
    name === "copy" && (
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="5" y="5" width="9" height="9" rx="1.5" />
        <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" />
      </g>
    )
  }
</svg>

<style>
  .brand-icon { display: inline-block; vertical-align: -0.15em; flex: none; }
</style>
