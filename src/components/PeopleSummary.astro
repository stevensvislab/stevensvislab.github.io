---
/**
 * Home-page summary of the team: a small photo, name, and role for everyone on
 * the People page except the pets (same order as /people/), ending with an open spot that links to Join.
 */
import { getCollection } from "astro:content";
import Contours from "./Contours.astro";
import { avatarSpec } from "../graphics/contourSets";
import Icon from "./Icon.astro";
import PublicImage from "./PublicImage.astro";
import { publicFile } from "../lib/site";

const order = ["faculty", "phd", "ms", "undergrad", "visiting"] as const;
const members = (await getCollection("people"))
  .filter((p) => (order as readonly string[]).includes(p.data.group))
  .sort(
    (a, b) =>
      order.indexOf(a.data.group as (typeof order)[number]) - order.indexOf(b.data.group as (typeof order)[number]) ||
      a.data.name.localeCompare(b.data.name),
  );
---

<ul class="people-summary">
  {
    members.map((p) => {
      const photo = publicFile("people", p.data.photo, `people.yaml (${p.id})`);
      return (
        <li>
          <a href={`/people/#${p.id}`}>
            <span class="avatar">
              {photo ? <PublicImage src={photo} alt="" sizes="64px" /> : <Contours {...avatarSpec(p.id)} />}
            </span>
            <span class="text">
              <b>{p.data.name}</b>
              <span>{p.data.role}</span>
            </span>
          </a>
        </li>
      );
    })
  }
  <li>
    <a href="/join/" class="open-spot">
      <span class="avatar"><Icon name="trailhead" /></span>
      <span class="text">
        <b>This could be you!</b>
        <span>Join us</span>
      </span>
    </a>
  </li>
</ul>

<style>
  .people-summary { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.9rem 1.4rem; }
  a { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: var(--ink); }
  .avatar {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    display: grid;
    place-items: center;
  }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .avatar :global(.contours) { position: absolute; inset: 0; }
  .text { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .text b { font-weight: 800; }
  .text span { font-size: 0.86rem; font-style: italic; color: var(--ink-2); }
  a:hover b { color: var(--stevens); text-decoration: underline; }
  .open-spot .avatar { border: 2px dashed var(--stevens); background: color-mix(in srgb, var(--stevens) 6%, var(--paper)); }
  .open-spot .avatar :global(.icon) { font-size: 1.9rem; color: var(--stevens); }
  .open-spot b { color: var(--stevens); }
</style>
