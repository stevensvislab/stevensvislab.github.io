---
/**
 * Top navigation. Desktop: one fixed bar with social icons and a wide Join
 * block on the far right. Mobile: IDL-style single row with a More menu
 * (a <details> disclosure, so it works without JavaScript); the brand bar is
 * hidden so the nav is the first thing on the page.
 */
import { brandHtml, site } from "../lib/site";
import BrandIcon from "./BrandIcon.astro";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const primary = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "People", href: "/people/" },
  { label: "Papers", href: "/papers/" },
];
const secondary = [
  { label: "Fun", href: "/fun/" },
  { label: "Blog", href: "/blog/" },
  { label: "Press", href: "/press/" },
  { label: "Code", href: site.github, external: true },
];
// "Code" in the nav already links to GitHub, so the GitHub icon is left out here.
const socials = site.socials.filter((s) => s.icon !== "github");
---

<header class="site-nav">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-name" set:html={brandHtml(site.shortName)} />
    </a>

    <nav class="desktop" aria-label="Main">
      <ul>
        {
          [...primary, ...secondary].map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={!("external" in item) && isActive(item.href) ? "page" : undefined}
                {...("external" in item ? { rel: "noopener" } : {})}
              >
                {item.label}
                {"external" in item && <BrandIcon name="external" size={10} />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      {socials.length > 0 && (
      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} rel="noopener" title={`${site.shortName} on ${s.name}`} class={`social ${s.icon}`}>
                <BrandIcon name={s.icon} />
                <span class="sr-only">{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      )}
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <Icon name="sun" class="sun" />
        <Icon name="moon" class="moon" />
      </button>
    </div>

    <a class="join" href="/join/" aria-current={isActive("/join/") ? "page" : undefined}>
      <Icon name="trailhead" />
      Join
    </a>
  </div>

  <nav class="mobile" aria-label="Main (mobile)">
    <ul>
      {
        primary.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/join/" class="join-m" aria-current={isActive("/join/") ? "page" : undefined}>Join</a>
      </li>
      <li class="more">
        <details>
          <summary>More<span aria-hidden="true"> ▾</span></summary>
          <ul>
            {
              secondary.map((item) => (
                <li>
                  <a href={item.href} {...("external" in item ? { rel: "noopener" } : {})}>
                    {item.label}
                    {"external" in item && <BrandIcon name="external" size={10} />}
                  </a>
                </li>
              ))
            }
            <li>
              <button class="theme-toggle as-link switch-row" type="button" role="switch" aria-checked="false">
                Dark/light mode
                <span class="switch" aria-hidden="true"><span class="knob"></span></span>
              </button>
            </li>
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  const toggles = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");
  const sync = () => {
    for (const b of toggles) if (b.getAttribute("role") === "switch") b.setAttribute("aria-checked", String(current() === "dark"));
  };
  for (const btn of toggles) {
    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      sync();
      try {
        localStorage.setItem("svl-theme", next);
      } catch {
        /* storage unavailable: the choice lasts for this page view */
      }
    });
  }
  sync();
  // Close the mobile More menu when clicking elsewhere.
  document.addEventListener("click", (e) => {
    const menu = document.querySelector<HTMLDetailsElement>(".site-nav .more details");
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: stretch;
    height: var(--nav-h);
    max-width: calc(var(--max) + 12rem);
    margin: 0 auto;
    padding-left: var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-right: auto;
    color: var(--ink);
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .desktop ul,
  .socials,
  .mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop { display: flex; }
  .desktop ul { display: flex; align-items: stretch; }
  .desktop a {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 100%;
    padding: 0 0.78rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 3px solid transparent;
    border-top: 3px solid transparent;
  }
  .desktop a:hover { color: var(--stevens); }
  .desktop a[aria-current="page"] { color: var(--ink); font-weight: 900; border-bottom-color: var(--stevens); }

  .tools { display: flex; align-items: center; gap: 0.2rem; padding: 0 0.6rem 0 0.4rem; }
  .socials { display: flex; gap: 0.15rem; }
  .social, .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .social:hover, .theme-toggle:hover { background: var(--paper-2); color: var(--ink); }
  .social.github:hover { color: var(--ink); }
  .social.youtube:hover { color: #e53122; }
  .social.linkedin:hover { color: #0a66c2; }
  .social.bluesky:hover { color: #1687ff; }
  .theme-toggle {
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 1.05rem;
  }
  .theme-toggle :global(.moon) { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.sun) { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.moon) { display: inline-block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.sun) { display: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.moon) { display: inline-block; }
  }

  /* Join: the widest, most prominent block, far right. */
  .join {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 2.1rem;
    background: var(--stevens);
    color: var(--on-stevens);
    font-weight: 900;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .join:hover { background: var(--stevens-hover); color: var(--on-stevens); }
  .join :global(.icon) { font-size: 1.1rem; }

  .mobile { display: none; }

  @media (max-width: 1100px) {
    .socials { display: none; }
  }

  @media (max-width: 860px) {
    .bar { display: none; }
    .mobile { display: block; }
    .mobile > ul {
      display: flex;
      justify-content: space-between;
      /* Align on the text baseline, so "More ▾" (whose arrow glyph shifts its line box) matches the links. */
      align-items: baseline;
      padding: 7px var(--gutter) 0;
      height: 40px;
    }
    .mobile a,
    .mobile summary,
    .as-link {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink-2);
      cursor: pointer;
    }
    .mobile a[aria-current="page"] { color: var(--ink); font-weight: 900; text-decoration: underline 2px var(--stevens); text-underline-offset: 6px; }
    .mobile .join-m { color: var(--stevens); font-weight: 900; }
    .mobile summary { list-style: none; }
    .mobile summary::-webkit-details-marker { display: none; }
    .more { position: relative; }
    .more details ul {
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      min-width: 11rem;
      background: var(--card);
      border: 1px solid var(--rule);
      border-radius: 10px;
      box-shadow: var(--shadow);
      padding: 0.4rem 0;
    }
    .more details li a, .as-link { display: block; padding: 0.6rem 1rem; }
    .more details li a :global(.brand-icon) { margin-left: 0.4rem; vertical-align: 0; }
    .as-link { font-family: inherit; border: 0; border-radius: 0; background: none; width: 100%; text-align: left; height: auto; }
    .more details li + li:last-child { border-top: 1px solid var(--rule); margin-top: 0.3rem; padding-top: 0.3rem; }
    .switch-row { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; white-space: nowrap; }
    .switch-row:hover { background: none; color: var(--ink); }
    .switch {
      position: relative;
      flex: none;
      width: 2.3rem;
      height: 1.3rem;
      border-radius: 999px;
      background: var(--rule-strong);
      transition: background 0.2s;
    }
    .knob {
      position: absolute;
      top: 0.15rem;
      left: 0.15rem;
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
      transition: translate 0.2s;
    }
    .switch-row[aria-checked="true"] .switch { background: var(--stevens); }
    .switch-row[aria-checked="true"] .knob { translate: 1rem 0; }
  }
</style>
