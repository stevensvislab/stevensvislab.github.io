---
/**
 * Renders a Markdown document's HTML (see lib/documents.ts) with the lab's styling: headings
 * with anchor offsets, quotes with an em-dash last line as epigraphs, numbered steps, and dashed
 * rules between the major (h2) parts.
 */
interface Props {
  html: string;
}
const { html } = Astro.props;
// A quote's last paragraph that starts with an em dash is its attribution.
const styled = html.replace(/<p>(\s*—)/g, '<p class="attribution">$1');
---

<div class="document prose" set:html={styled} />

<style>
  .document :global(h2),
  .document :global(h3),
  .document :global(h4) { scroll-margin-top: 90px; }
  .document :global(h2:not(:first-child)) {
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--rule-strong);
  }
  .document :global(h3:not(:first-child)) { margin-top: 1.8rem; }
  .document :global(h4) {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    margin: 1.1rem 0 0.3rem;
  }
  .document :global(blockquote) {
    margin: 0.5rem 0 1.4rem;
    padding: 0 0 0 1.2rem;
    border-left: 2px dashed var(--rule-strong);
  }
  .document :global(blockquote p) {
    font-size: 1.18rem;
    font-style: italic;
    line-height: 1.5;
    margin: 0 0 0.4rem;
  }
  .document :global(blockquote p.attribution) {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .document :global(ol) { padding-left: 1.3rem; }
  .document :global(ol li) { margin-bottom: 0.7rem; }
  .document :global(ol li::marker) {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--stevens);
  }
</style>
