---
/**
 * Footer: DIG-style generous dark band with a background mark (here,
 * topographic contours), datavisards' three-column content, and an elevation
 * ridge along the top whose peaks are the lab's papers per year.
 */
import { brandHtml, builtOn, formatMonth, getPapers, site } from "../lib/site";
import { ridge } from "../graphics/ridge";
import BrandIcon from "./BrandIcon.astro";
import Contours from "./Contours.astro";
import { FOOTER } from "../graphics/contourSets";
import Logo from "./Logo.astro";

interface Props {
  /** Repo-relative path of the page's source, for the "Edit this page" link. */
  editPath?: string;
}
const { editPath } = Astro.props;

const papers = await getPapers();
const counts = new Map<number, number>();
for (const p of papers) counts.set(p.data.year, (counts.get(p.data.year) ?? 0) + 1);
const W = 1200, H = 70;
const { crest, area, peaks } = ridge(counts, W, H);
const editUrl = editPath ? `${site.editBase}/${editPath}` : site.editBase.replace("/edit/", "/tree/");
---

<footer class="site-footer">
  <svg class="ridge" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-labelledby="ridge-title">
    <title id="ridge-title">Elevation profile of the lab's papers per year: {peaks.map((p) => `${p.year}, ${p.count}`).join("; ")}</title>
    <path d={area} class="ridge-fill"></path>
    <path d={crest} class="ridge-line"></path>
  </svg>
  <div class="band">
    <Contours {...FOOTER} color="var(--night-contour)" class="footer-contours" />
    <div class="wrap inner">
      <div class="col marks">
        <a class="stevens-card" href={site.institution.url} rel="noopener">
          <img src="/logos/stevens-logo.svg" alt={site.institution.name} width="130" height="180" loading="lazy" />
        </a>
        <p class="small">
          <a href={site.institution.schoolUrl} rel="noopener">{site.institution.school}</a><br />
          {site.location.building}<br />
          {site.location.street}, {site.location.city}
        </p>
      </div>

      <div class="col community">
        <Logo size={38} class="footer-logo" />
        <p class="hello">Hello from Hoboken. <a href="/join/">Come join us!</a></p>
        <p class="small">
          Want to make an edit? <a href={editUrl} rel="noopener">Contribute on GitHub.</a>
        </p>
        <p class="small copy">© {builtOn.getUTCFullYear()} <span set:html={brandHtml(site.name)} /></p>
      </div>

      <div class="col meta">
        <ul class="socials">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.url} rel="noopener">
                  <BrandIcon name={s.icon} />
                  <span>{s.handle}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${site.email}`}>
              <BrandIcon name="email" />
              <span>{site.email}</span>
            </a>
          </li>
        </ul>
        <p class="small disclaimer">
          This website and lab is informally maintained by the affiliated faculty and students and does not officially
          represent Stevens Institute of Technology.
        </p>
      </div>
    </div>
    <p class="wrap map-label mono">
      <span>{site.location.coords}</span>
      <span aria-hidden="true">·</span>
      <span>Hoboken, NJ</span>
      <span aria-hidden="true">·</span>
      <span>Last updated {formatMonth(builtOn)}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; color: var(--night-ink); }
  .ridge { display: block; width: 100%; height: 56px; margin-bottom: -1px; }
  .ridge-fill { fill: var(--night); }
  .ridge-line { fill: none; stroke: var(--stevens); stroke-width: 1.5; stroke-dasharray: 5 5; vector-effect: non-scaling-stroke; opacity: 0.8; }
  .band {
    position: relative;
    background: var(--night);
    padding: 3.2rem 0 1.4rem;
    overflow: hidden;
    isolation: isolate;
  }
  .band :global(.footer-contours) { z-index: -1; opacity: 0.9; }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem 3rem; /* row gap, column gap */
    align-items: start;
  }
  .col { display: flex; flex-direction: column; gap: 0.5rem; }
  .marks { align-items: flex-start; }
  .community { align-items: center; text-align: center; }
  /* Stretch to the row's height so the disclaimer lines up with the bottom of the Stevens address on the left. */
  .meta { align-items: flex-end; align-self: stretch; justify-content: space-between; }
  /* The logo is white artwork made for dark backgrounds, so it sits directly on the footer. */
  .stevens-card { display: inline-block; }
  .stevens-card img { display: block; height: 180px; width: auto; }
  .small { font-size: 0.86rem; color: var(--night-muted); margin: 0; line-height: 1.55; }
  .disclaimer { max-width: 22rem; margin-top: 3rem; text-align: right; }
  .hello { font-family: var(--font-display); font-size: 1.3rem; margin: 0.2rem 0 0.1rem; }
  .copy { font-size: 0.8rem; }
  .copy :global(.vis) { color: #f08a99; }
  a { color: var(--night-ink); text-decoration-color: color-mix(in srgb, var(--night-ink) 35%, transparent); }
  a:hover { color: #fff; text-decoration-color: #fff; }
  :global(.footer-logo) { color: var(--night-ink); }
  .socials { list-style: none; margin: 0; padding: 1.5rem 0 0; display: grid; gap: 0.45rem; }
  .socials a { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.88rem; text-decoration: none; }
  .map-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin: 2.4rem auto 0;
    color: var(--night-muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; text-align: left; }
    .community, .meta { align-items: flex-start; text-align: left; }
    .disclaimer { text-align: left; margin-top: 2rem; }
    .map-label { justify-content: flex-start; }
  }
</style>
