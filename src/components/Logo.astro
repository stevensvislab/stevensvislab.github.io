---
/**
 * Lab mark: a compass rose whose four points have different lengths, like a
 * tiny radial bar chart. North is Stevens red.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;

const c = 16;
const point = (angle: number, len: number, w = 2.6) => {
  const rad = (angle * Math.PI) / 180;
  const [dx, dy] = [Math.sin(rad), -Math.cos(rad)];
  const [px, py] = [-dy, dx];
  const f = (n: number) => n.toFixed(2);
  return `${f(c + dx * len)},${f(c + dy * len)} ${f(c + px * w)},${f(c + py * w)} ${f(c - px * w)},${f(c - py * w)}`;
};
---

<svg class:list={["logo", className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx={c} cy={c} r="14.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2.2 2.4" opacity="0.55"></circle>
  <polygon points={point(90, 9.5)} fill="currentColor"></polygon>
  <polygon points={point(180, 11)} fill="currentColor"></polygon>
  <polygon points={point(270, 7)} fill="currentColor"></polygon>
  <polygon points={point(0, 14)} fill="var(--stevens)"></polygon>
  <circle cx={c} cy={c} r="2.2" fill="var(--paper)" stroke="currentColor" stroke-width="1.2"></circle>
</svg>

<style>
  .logo { flex: none; }
</style>
