---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import { ABOUT } from "../graphics/contourSets";
import Icon from "../components/Icon.astro";
import { getPapers, inlineMd, site, vocab } from "../lib/site";

const partners = await getCollection("partners");
const sponsors = await getCollection("sponsors");

// Collaborators: every partner organization on a lab paper, most papers first.
const papers = await getPapers();
const orgCounts = new Map<string, number>();
for (const p of papers) for (const o of p.data.partners) orgCounts.set(o, (orgCounts.get(o) ?? 0) + 1);
const collaborators = Object.entries(vocab.orgs)
  .filter(([key]) => orgCounts.has(key))
  .sort(([a], [b]) => orgCounts.get(b)! - orgCounts.get(a)!)
  .map(([, org]) => org);
---

<Base title="About" description={`About the ${site.name} at Stevens: our mission, our values, partner labs at Stevens, and the collaborators we build with.`} editPath="src/pages/about.astro" topContours={false}>
  <section class="hero">
    <Contours {...ABOUT} class="about-contours" />
    <div class="wrap">
      <header class="page-head">
        <h1>About</h1>
        <Icon name="visitorCenter" />
      </header>
      <blockquote class="epigraph">
        <p>"Visual analytics is the science of analytical reasoning facilitated by interactive visual interfaces."</p>
        <footer>James J. Thomas &amp; Kristin A. Cook, <cite>Illuminating the Path</cite> (2005)</footer>
      </blockquote>
    </div>
  </section>

  <div class="wrap">
    <section class="prose">
      <p class="mission" set:html={inlineMd(site.mission)} />
      {site.whatWeDo.map((para) => <p set:html={inlineMd(para)} />)}
    </section>

    <section class="section" aria-labelledby="values">
      <h2 id="values" class="waypoint"><Icon name="sign" />Our values</h2>
      <ul class="values">
        {
          site.values.map((v) => (
            <li>
              <h3>{v.title}</h3>
              <p set:html={inlineMd(v.text)} />
            </li>
          ))
        }
      </ul>
    </section>

    {
      partners.length > 0 && (
        <section class="section" aria-labelledby="partners">
          <h2 id="partners" class="waypoint"><Icon name="rangerStation" />Partners at Stevens</h2>
          <ul class="logo-cards">
            {partners.map((p) => (
              <li>
                <a class="logo-card" href={p.data.url} rel="noopener">
                  <span class="logo-box">{p.data.logo ? <img src={`/logos/${p.data.logo}`} alt="" loading="lazy" /> : <Icon name="mountain" />}</span>
                  <span class="logo-name">{p.data.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      collaborators.length > 0 && (
        <section class="section" aria-labelledby="collaborators">
          <h2 id="collaborators" class="waypoint"><Icon name="campground" />Collaborators</h2>
          <ul class="logo-cards">
            {collaborators.map((o) => (
              <li class="logo-card">
                <span class="logo-box">{o.logo ? <img src={`/logos/${o.logo}`} alt="" loading="lazy" /> : <Icon name="pine" />}</span>
                <span class="logo-name">{o.name}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Hidden while src/data/sponsors.yaml is empty. */}
    {
      sponsors.length > 0 && (
        <section class="section" aria-labelledby="sponsors">
          <h2 id="sponsors" class="waypoint"><Icon name="star" />Sponsors</h2>
          <ul class="logo-cards">
            {sponsors.map((s) => (
              <li>
                <a class="logo-card" href={s.data.url} rel="noopener">
                  <span class="logo-box">{s.data.logo ? <img src={`/logos/${s.data.logo}`} alt="" loading="lazy" /> : <Icon name="star" />}</span>
                  <span class="logo-name">{s.data.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: 0 0 0.6rem; isolation: isolate; }
  .hero :global(.about-contours) { z-index: -1; mask-image: linear-gradient(transparent, #000 30%, transparent); -webkit-mask-image: linear-gradient(transparent, #000 30%, transparent); }
  .hero .epigraph { margin-top: 0.4rem; }
  .prose { max-width: 50rem; }
  .mission { font-size: 1.2rem; }

  .values { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
  .values li { background: var(--card); border: 1px solid var(--rule); border-top: 3px solid var(--stevens); border-radius: var(--radius); padding: 1rem 1.15rem; }
  .values h3 { font-size: 1.12rem; margin-bottom: 0.4rem; }
  .values p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }

  .logo-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11.5rem), 1fr)); gap: 0.9rem; }
  .logo-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 0.8rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  a.logo-card:hover { border-color: var(--stevens); color: var(--stevens); }
  /* Logos are made for light backgrounds, so they sit on white in both themes. */
  .logo-box { display: grid; place-items: center; width: 100%; height: 64px; background: #fff; border-radius: 8px; padding: 0.4rem; }
  .logo-box img { max-height: 52px; max-width: 100%; width: auto; object-fit: contain; }
  .logo-box :global(.icon) { font-size: 2rem; color: var(--forest); }
  .logo-name { font-size: 0.88rem; font-weight: 700; line-height: 1.3; }
</style>
