---
/**
 * Join / Prospectus. The page text is a Markdown document (src/content/documents/prospectus.md);
 * this page adds the head, the announcement, and an "On this page" list built from its headings.
 * The line `<!-- lab-culture -->` in the prospectus is replaced by the lab culture document.
 */
import Base from "../layouts/Base.astro";
import Document from "../components/Document.astro";
import Icon from "../components/Icon.astro";
import { getDocument, nestHeadings, outline } from "../lib/documents";
import { inlineMd, site } from "../lib/site";

const prospectus = await getDocument("prospectus");
const culture = await getDocument("lab-culture");
const html = prospectus.html.replace(/<!--\s*lab-culture\s*-->/, nestHeadings(culture.html, 1));

// "On this page": each h2 with the h3s under it.
const toc: { id: string; text: string; items: { id: string; text: string }[] }[] = [];
for (const h of outline(html)) {
  if (h.depth === 2) toc.push({ id: h.id, text: h.text, items: [] });
  else toc.at(-1)?.items.push({ id: h.id, text: h.text });
}
---

<Base
  title="Join us"
  description="Join the Stevens Visualization Lab as a Ph.D., master's, or undergraduate student, or as a visiting scholar or intern. What to expect and how to apply."
  editPath="src/content/documents/prospectus.md"
>
  <div class="wrap narrow">
    <header class="page-head">
      <h1>{prospectus.title}</h1>
      <Icon name="trailhead" />
      <p class="note">We're building a lab of curious people who want to help others make sense of complex data.</p>
    </header>

    {
      site.announcement.show && (
        <div class="callout">
          <Icon name="information" />
          <p set:html={inlineMd(site.announcement.text)} />
        </div>
      )
    }

    <nav class="toc" aria-label="On this page">
      <p class="lead">On this page</p>
      <ol>
        {
          toc.map((part) => (
            <li>
              <a href={`#${part.id}`}>{part.text}</a>
              <ul>
                {part.items.map((item) => (
                  <li>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </nav>

    <Document html={html} />
  </div>
</Base>

<style>
  .toc {
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    margin: 0 0 1rem;
  }
  .toc .lead {
    margin: 0 0 0.4rem;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  .toc ol > li > a {
    font-weight: 800;
  }
  .toc ul {
    margin: 0.2rem 0 0;
    padding-left: 1rem;
    list-style: none;
    font-size: 0.88rem;
  }
  .toc ul li {
    margin-bottom: 0.1rem;
  }
</style>
