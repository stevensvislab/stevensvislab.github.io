---
/** Blog listing in the VIS Design Lab style: title + date, lead image, excerpt. */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PublicImage from "../../components/PublicImage.astro";
import { formatDay, getLinkedPaper, publicFile } from "../../lib/site";
import { postUrl } from "../../lib/blog";

const posts = await Promise.all(
  (await getCollection("blog", (p) => !p.data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async (p) => ({ ...p, linked: await getLinkedPaper(p.data.paper, `blog/${p.id}.md`) })),
);
---

<Base title="Blog" description="Trail reports from the Stevens Visualization Lab: what we asked, what we built, and what we found in our visualization and AI research." editPath="src/content/blog">
  <div class="wrap narrow">
    <header class="page-head">
      <h1>Blog</h1>
      <p class="subtitle">Trail reports.&nbsp;<Icon name="selfGuidingTrail" /></p>
      <p class="note"><a href="/rss.xml">Subscribe via RSS.</a></p>
    </header>

    {
      posts.length === 0 ? (
        <div class="empty">
          <Icon name="hiker" />
          <p>The first trail report is being written. Check back soon!</p>
        </div>
      ) : (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <article>
                <h2>
                  <a href={postUrl(post)}>{post.data.title}</a> <time datetime={post.data.date.toISOString()}>{formatDay(post.data.date)}</time>
                </h2>
                {post.data.image && (
                  <a href={postUrl(post)} tabindex="-1" aria-hidden="true">
                    <PublicImage src={publicFile("blog", post.data.image, `blog/${post.id}.md`)!} alt="" sizes="(max-width: 760px) 100vw, 720px" class="lead-img" />
                  </a>
                )}
                <p>{post.data.lede}</p>
                {post.linked && (
                  <p class="paper-ref">
                    Paper: <a href={`/papers/${post.linked.id}/`}>{post.linked.data.title}</a>
                  </p>
                )}
                <a class="more-link" href={postUrl(post)}>Read the report</a>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li { padding: 1.6rem 0; border-top: 1px dashed var(--rule-strong); }
  h2 { font-size: 1.35rem; }
  h2 a { text-decoration: none; }
  time { display: block; font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); margin-top: 0.3rem; font-weight: 400; }
  .paper-ref { font-size: 0.9rem; color: var(--muted); }
  .paper-ref a { font-weight: 700; color: var(--ink-2); }
  :global(.lead-img) { border-radius: 12px; border: 1px solid var(--rule); margin: 0.6rem 0 0.9rem; }
</style>
